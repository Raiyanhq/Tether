# Model provider: gemini (default) or anthropic. If unset, whichever key below is set is used (Gemini first).
LLM_PROVIDER=gemini

# --- Gemini (default) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic (optional alternative) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=8787
# Comma-separated. Must include your extension origin. The default is the extension's fixed id.
ALLOWED_ORIGINS=chrome-extension://dncappfhfginimfcnmcndijoophkdcpl
RATE_LIMIT_PER_MIN=60
# Set to 1 when deployed behind a reverse proxy / PaaS load balancer
TRUST_PROXY=0

# --- Natural voice (optional): ElevenLabs. Without a key, Tutor Mode uses the browser's built-in voice. ---
# ELEVENLABS_API_KEY=
# Pick any voice available to your account (Voices page, copy its id). Default is a premade voice.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_flash_v2_5
