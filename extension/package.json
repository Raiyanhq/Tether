{
  "name": "tether-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts",
    "build:demo": "VITE_DEV_TOOLS=1 npm run build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "OUT_DIR=dist-e2e VITE_SERVER_URL=http://localhost:8788 VITE_DEV_TOOLS=1 npm run build && OUT_DIR=dist-e2e node e2e/run.mjs"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "katex": "^0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.65.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^4.1.12"
  }
}
